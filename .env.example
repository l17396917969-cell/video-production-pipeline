# 复制这份为 .env，填上自己的 key
# 不要把 .env 提交到任何地方

# TTS 配音（MiniMax）
# 获取：https://platform.minimaxi.com/ → 接口密钥
MINIMAX_API_KEY=

# 备选 TTS（火山引擎豆包语音），需要两个值
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# B-roll 空镜（Pexels，免费）
# 获取：https://www.pexels.com/api/
PEXELS_API_KEY=

# 配乐（如果走 API 才需要；Artlist/Epidemic 是订阅制，不用填）
MUBERT_API_KEY=
